{
    "name": "anime-db/plugin-contracts",
    "description": "Plugin contracts (interfaces and DTOs) for AnimeDB v2 plugins",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/anime-db/anime-db-plugin-contracts",
    "authors": [
        {
            "name": "Peter Gribanov",
            "homepage": "https://github.com/peter-gribanov"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.5",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "AnimeDb\\PluginContracts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AnimeDb\\PluginContracts\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
